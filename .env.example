FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=replace-this-before-deployment

# Shared team MySQL (recommended): one cloud instance, every member uses the same URL.
# Local Docker fallback: mysql+pymysql://knowbook:knowbook_dev@127.0.0.1:3307/knowbook
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/knowbook
